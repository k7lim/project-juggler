#!/bin/sh
set -eu

# Follow symlinks so this script can live on PATH while still finding the
# project checkout. Unlike a pip-generated console script, this launcher does
# not pin the absolute path of the Python interpreter that created it.
source_path=$0
while [ -L "$source_path" ]; do
    source_dir=$(CDPATH= cd -P "$(dirname "$source_path")" && pwd)
    link_target=$(readlink "$source_path")
    case $link_target in
        /*) source_path=$link_target ;;
        *) source_path=$source_dir/$link_target ;;
    esac
done

script_dir=$(CDPATH= cd -P "$(dirname "$source_path")" && pwd)
project_root=$(CDPATH= cd -P "$script_dir/.." && pwd)
export PYTHONPATH="$project_root${PYTHONPATH:+:$PYTHONPATH}"

exec python3 -m pj "$@"
